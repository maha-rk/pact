GEMINI_API_KEY=your-gemini-api-key-here

# Optional: enables a real Vertex AI fallback for the two Gemini call
# sites, only attempted if the Developer API call above fails (e.g. its
# free-tier rate limit). Requires `gcloud auth application-default login`
# and a GCP project with billing + the Vertex AI API enabled.
GCP_PROJECT_ID=your-gcp-project-id
