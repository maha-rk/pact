GEMINI_API_KEY=your-gemini-api-key-here

# Optional: enables a real Vertex AI fallback for the two Gemini call
# sites, only attempted if the Developer API call above fails (e.g. its
# free-tier rate limit). Requires `gcloud auth application-default login`
# and a GCP project with billing + the Vertex AI API enabled.
GCP_PROJECT_ID=your-gcp-project-id

# Optional: real JWT authentication (PRD §23a) on negotiation-mutating
# endpoints. Off by default -- this build has no end-user accounts yet,
# so gating its own demo UI from itself isn't meaningful, but the
# mechanism is real and tested (tests/integration/test_gateway.py). Set
# all three to actually require a bearer token:
AUTH_REQUIRED=false
PACT_JWT_SECRET=a-long-random-secret-at-least-32-bytes
PACT_API_KEY=a-pre-shared-key-to-exchange-for-a-jwt-via-post-auth-token

# Optional: real distributed negotiation execution (PRD §23c) -- a
# worker process + standalone Compliance Agent service, dispatched over
# real Google Cloud Pub/Sub, with Firestore as the shared state store.
# Off by default; the live demo runs the in-process orchestration graph.
# Only takes effect if Pub/Sub and Firestore are actually reachable
# (probed, not trusted) -- otherwise falls back to in-process with a
# loud warning. Requires GCP_PROJECT_ID above plus real ADC.
PACT_DISTRIBUTED=false

# Optional: real, application-level AES-256-GCM encryption (PRD §26) for
# the sensitive fields written to BigQuery (budget ceiling, final price,
# reasoning). Off by default -- falls back to plaintext with a loud
# warning at write time, not silently. Generate a real key with:
#   python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
PACT_FIELD_ENCRYPTION_KEY=a-base64-encoded-32-byte-key-see-comment-above
