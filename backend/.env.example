GEMINI_API_KEY=your-gemini-api-key-here

# Optional: enables a real Vertex AI fallback for the two Gemini call
# sites, only attempted if the Developer API call above fails (e.g. its
# free-tier rate limit). Requires `gcloud auth application-default login`
# and a GCP project with billing + the Vertex AI API enabled.
GCP_PROJECT_ID=your-gcp-project-id

# Optional: real JWT authentication (PRD §23a) on negotiation-mutating
# endpoints. Off by default -- this build has no end-user accounts yet,
# so gating its own demo UI from itself isn't meaningful, but the
# mechanism is real and tested (tests/integration/test_gateway.py). Set
# all three to actually require a bearer token:
AUTH_REQUIRED=false
PACT_JWT_SECRET=a-long-random-secret-at-least-32-bytes
PACT_API_KEY=a-pre-shared-key-to-exchange-for-a-jwt-via-post-auth-token
